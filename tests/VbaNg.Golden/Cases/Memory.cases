' Memory: what VBA lays out in memory (ARCHITECTURE.md D20, section 6; ROADMAP.md WP2 A), recorded
' as relations wherever VBA guarantees only relations: distances between elements and members,
' pointers compared with each other, bytes read back through MoveMemory. Excel is 64-bit here, so
' a pointer is 8 bytes, a Variant 24, and LongPtr is LongLong. Tracker is the companion class
' whose Class_Terminate writes to Trace, so an object round trip through a LongPtr shows when the
' object dies.

Option Explicit

Private Declare PtrSafe Sub MoveMemory Lib "kernel32" Alias "RtlMoveMemory" (ByRef destination As Any, ByRef source As Any, ByVal length As LongPtr)
Private Declare PtrSafe Function VarPtrArray Lib "VBE7" Alias "VarPtr" (ByRef items() As Any) As LongPtr

Public Trace As String

Private Type TPair
    A As Long
    B As Long
End Type

Private Type TMixed
    B As Byte
    L As Long
    D As Double
    S As String
    I As Integer
    C As Currency
End Type

Private Type TWithString
    Text As String
    N As Long
End Type

Private Type TFixed
    F As String * 4
    N As Long
End Type

Private Type TGuid
    D1 As Long
    D2 As Integer
    D3 As Integer
    D4(0 To 7) As Byte
End Type

Private Type TAligned
    B As Byte
    L(1 To 2) As Long
End Type

Private Type TStrings
    N As Integer
    S(0 To 1) As String
End Type

Private Type TBool
    A As Byte
    B As Boolean
    C As Byte
End Type

Private Type TDyn
    N As Long
    A() As Long
    M As Long
End Type

Private Type TIn
    X As Long
    Y As Byte
End Type

Private Type TOut
    B As Byte
    P(0 To 1) As TIn
    Z As Byte
End Type

Private Type TNest
    B As Byte
    Inner As TIn
    Z As Byte
End Type

Private Type TFS
    B As Byte
    S(0 To 1) As String * 3
    Z As Byte
End Type

Private Type TFS1
    B As Byte
    S As String * 3
    Z As Byte
End Type

Private Function ReadByte(ByVal address As LongPtr) As Byte
    Dim value As Byte
    MoveMemory value, ByVal address, 1
    ReadByte = value
End Function

Private Function ReadInteger(ByVal address As LongPtr) As Integer
    Dim value As Integer
    MoveMemory value, ByVal address, 2
    ReadInteger = value
End Function

Private Function ReadLong(ByVal address As LongPtr) As Long
    Dim value As Long
    MoveMemory value, ByVal address, 4
    ReadLong = value
End Function

Private Function ReadLongPtr(ByVal address As LongPtr) As LongPtr
    Dim value As LongPtr
    MoveMemory value, ByVal address, 8
    ReadLongPtr = value
End Function

Private Function ReadDouble(ByVal address As LongPtr) As Double
    Dim value As Double
    MoveMemory value, ByVal address, 8
    ReadDouble = value
End Function

Private Function AddressOfByRef(ByRef n As Long) As LongPtr
    AddressOfByRef = VarPtr(n)
End Function

Private Function AddressOfByVal(ByVal n As Long) As LongPtr
    AddressOfByVal = VarPtr(n)
End Function

Private Function AddressOfVariant(ByRef v As Variant) As LongPtr
    AddressOfVariant = VarPtr(v)
End Function

Private Function MissingType(Optional ByRef v As Variant) As Integer
    MissingType = ReadInteger(VarPtr(v))
End Function

Private Function MissingCode(Optional ByRef v As Variant) As Long
    MissingCode = ReadLong(VarPtr(v) + 8)
End Function

Private Function StaticAddress() As LongPtr
    Static s As Long
    StaticAddress = VarPtr(s)
End Function

' Consecutive Byte elements are one byte apart
Dim a(1) As Byte
? VarPtr(a(1)) - VarPtr(a(0))

' Consecutive Integer elements
Dim a(1) As Integer
? VarPtr(a(1)) - VarPtr(a(0))

' Consecutive Long elements
Dim a(1) As Long
? VarPtr(a(1)) - VarPtr(a(0))

' Consecutive LongLong elements
Dim a(1) As LongLong
? VarPtr(a(1)) - VarPtr(a(0))

' Consecutive Single elements
Dim a(1) As Single
? VarPtr(a(1)) - VarPtr(a(0))

' Consecutive Double elements
Dim a(1) As Double
? VarPtr(a(1)) - VarPtr(a(0))

' Consecutive Currency elements
Dim a(1) As Currency
? VarPtr(a(1)) - VarPtr(a(0))

' Consecutive Date elements
Dim a(1) As Date
? VarPtr(a(1)) - VarPtr(a(0))

' Consecutive Boolean elements
Dim a(1) As Boolean
? VarPtr(a(1)) - VarPtr(a(0))

' Consecutive String elements are a pointer apart
Dim a(1) As String
? VarPtr(a(1)) - VarPtr(a(0))

' Consecutive Object elements are a pointer apart
Dim a(1) As Object
? VarPtr(a(1)) - VarPtr(a(0))

' Consecutive Variant elements are a VARIANT apart
Dim a(1) As Variant
? VarPtr(a(1)) - VarPtr(a(0))

' Consecutive elements of a type are LenB apart
Dim a(1) As TMixed
? VarPtr(a(1)) - VarPtr(a(0))
? LenB(a(0))
? Len(a(0))

' The members of a type sit at their natural alignment
Dim t As TMixed
? VarPtr(t.B) = VarPtr(t)
? VarPtr(t.L) - VarPtr(t)
? VarPtr(t.D) - VarPtr(t)
? VarPtr(t.S) - VarPtr(t)
? VarPtr(t.I) - VarPtr(t)
? VarPtr(t.C) - VarPtr(t)
? LenB(t)

' Two Longs in a type are adjacent
Dim p As TPair
? VarPtr(p.B) - VarPtr(p.A)
? LenB(p)

' A ByRef parameter is the caller's variable
Dim n As Long
? AddressOfByRef(n) = VarPtr(n)

' A ByVal parameter is a copy
Dim n As Long
? AddressOfByVal(n) = VarPtr(n)

' A Variant passed ByRef is the caller's variable
Dim v As Variant
? AddressOfVariant(v) = VarPtr(v)

' A Long passed to a ByRef Variant parameter arrives as a temporary
Dim n As Long
? AddressOfVariant(n) = VarPtr(n)

' A Static local keeps its address across calls
? StaticAddress() = StaticAddress()

' StrPtr of vbNullString and of an unassigned String
Dim s As String
? StrPtr(vbNullString)
? StrPtr(s)

' StrPtr of an empty string literal is a BSTR of length zero
Dim s As String
s = ""
? StrPtr(s) <> 0
? ReadLong(StrPtr(s) - 4)

' StrPtr of a string is not the variable's address, and the variable holds it
Dim s As String
s = "abc"
? StrPtr(s) <> 0
? StrPtr(s) = VarPtr(s)
? ReadLongPtr(VarPtr(s)) = StrPtr(s)

' The BSTR length prefix is the byte count
Dim s As String
s = "abc"
? ReadLong(StrPtr(s) - 4)
? LenB(s)

' The BSTR holds UTF-16 code units and a terminator
Dim s As String
s = "abc"
? ReadInteger(StrPtr(s))
? ReadInteger(StrPtr(s) + 2)
? ReadInteger(StrPtr(s) + 6)

' A wide character is one code unit
Dim s As String
s = ChrW(&H20AC)
? ReadLong(StrPtr(s) - 4)
? ReadInteger(StrPtr(s)) And &HFFFF&

' Two strings swapped through their pointers
Dim s1 As String
Dim s2 As String
Dim p1 As LongPtr
Dim p2 As LongPtr
s1 = "first"
s2 = "second"
p1 = StrPtr(s1)
p2 = StrPtr(s2)
MoveMemory ByVal VarPtr(s1), p2, 8
MoveMemory ByVal VarPtr(s2), p1, 8
? s1
? s2
? StrPtr(s1) = p2

' The vt of a Variant holding each scalar type
Dim v As Variant
? ReadInteger(VarPtr(v))
v = 1
? ReadInteger(VarPtr(v))
v = 1&
? ReadInteger(VarPtr(v))
v = 1.5
? ReadInteger(VarPtr(v))
v = 1!
? ReadInteger(VarPtr(v))
v = "s"
? ReadInteger(VarPtr(v))
v = True
? ReadInteger(VarPtr(v))
v = CByte(1)
? ReadInteger(VarPtr(v))
v = CCur(1)
? ReadInteger(VarPtr(v))
v = #1/2/2003#
? ReadInteger(VarPtr(v))
v = CDec(1)
? ReadInteger(VarPtr(v))
v = CLngLng(1)
? ReadInteger(VarPtr(v))
v = Null
? ReadInteger(VarPtr(v))
v = Empty
? ReadInteger(VarPtr(v))

' The vt of a Variant holding an error, an object, Nothing, and arrays
Dim v As Variant
Dim la() As Long
v = CVErr(5)
? ReadInteger(VarPtr(v))
? ReadLong(VarPtr(v) + 8)
Set v = New Collection
? ReadInteger(VarPtr(v))
? ReadLongPtr(VarPtr(v) + 8) = ObjPtr(v)
Set v = Nothing
? ReadInteger(VarPtr(v))
? ReadLongPtr(VarPtr(v) + 8)
ReDim la(0)
v = la
? ReadInteger(VarPtr(v))
v = Array(1, 2)
? ReadInteger(VarPtr(v))
? VarType(v)

' The vt and the payload of a missing argument
? MissingType()
? MissingCode()

' A Variant's payload starts eight bytes in
Dim v As Variant
v = 42&
? ReadLong(VarPtr(v) + 8)
v = 1.5
? ReadDouble(VarPtr(v) + 8)
v = True
? ReadInteger(VarPtr(v) + 8)
v = CByte(7)
? ReadByte(VarPtr(v) + 8)
v = "abc"
? ReadLongPtr(VarPtr(v) + 8) = StrPtr(v)

' A Decimal fills the Variant from its scale byte
Dim v As Variant
v = CDec("1.5")
? ReadByte(VarPtr(v) + 2)
? ReadByte(VarPtr(v) + 3)
? ReadLong(VarPtr(v) + 8)
v = CDec(-2)
? ReadByte(VarPtr(v) + 3)
? ReadLong(VarPtr(v) + 8)

' ObjPtr is the same through every reference to the object
Dim c As Collection
Dim d As Collection
Dim o As Object
Set c = New Collection
Set d = c
? ObjPtr(c) <> 0
? ObjPtr(c) = ObjPtr(d)
? ObjPtr(o)
? ReadLongPtr(VarPtr(c)) = ObjPtr(c)

' An object reached through its pointer without AddRef, and when it dies
Dim t As Tracker
Dim u As Tracker
Dim address As LongPtr
Dim zero As LongPtr
Trace = ""
Set t = New Tracker
address = ObjPtr(t)
MoveMemory u, address, 8
? u.Id
? ObjPtr(u) = address
? Trace
MoveMemory u, zero, 8
? u Is Nothing
? Trace
Set t = Nothing
? Trace

' The SAFEARRAY descriptor of a fixed one-dimensional array
Dim a(2 To 5) As Long
Dim d As LongPtr
d = ReadLongPtr(VarPtrArray(a))
? ReadInteger(d)
? ReadInteger(d + 2)
? ReadLong(d + 4)
? ReadLong(d + 8)
? ReadLongPtr(d + 16) = VarPtr(a(2))
? ReadLong(d + 24)
? ReadLong(d + 28)

' The SAFEARRAY descriptor of a dynamic array
Dim b() As Long
Dim d As LongPtr
ReDim b(0 To 9)
d = ReadLongPtr(VarPtrArray(b))
? ReadInteger(d)
? ReadInteger(d + 2)
? ReadLong(d + 4)
? ReadLongPtr(d + 16) = VarPtr(b(0))
? ReadLong(d + 24)
? ReadLong(d + 28)

' The SAFEARRAY descriptor of a Variant array and a String array
Dim va(1) As Variant
Dim sa(1) As String
? ReadInteger(ReadLongPtr(VarPtrArray(va)) + 2)
? ReadLong(ReadLongPtr(VarPtrArray(va)) + 4)
? ReadInteger(ReadLongPtr(VarPtrArray(sa)) + 2)
? ReadLong(ReadLongPtr(VarPtrArray(sa)) + 4)

' The bounds of a two-dimensional array in the descriptor, last dimension first
Dim m(1 To 3, 1 To 2) As Long
Dim d As LongPtr
d = ReadLongPtr(VarPtrArray(m))
? ReadInteger(d)
? ReadLong(d + 24)
? ReadLong(d + 28)
? ReadLong(d + 32)
? ReadLong(d + 36)

' The elements of a two-dimensional array in memory, first index fastest
Dim m(1 To 3, 1 To 2) As Long
? VarPtr(m(2, 1)) - VarPtr(m(1, 1))
? VarPtr(m(1, 2)) - VarPtr(m(1, 1))

' An unallocated dynamic array has no descriptor
Dim b() As Long
? ReadLongPtr(VarPtrArray(b))
ReDim b(0)
? ReadLongPtr(VarPtrArray(b)) <> 0
Erase b
? ReadLongPtr(VarPtrArray(b))

' Erase keeps a fixed array where it is
Dim a(1) As Long
Dim address As LongPtr
a(0) = 5
address = VarPtr(a(0))
Erase a
? VarPtr(a(0)) = address
? a(0)

' ReDim Preserve to the same size and to a larger one
Dim b() As Long
Dim address As LongPtr
ReDim b(0 To 3)
b(0) = 9
address = VarPtr(b(0))
ReDim Preserve b(0 To 3)
? VarPtr(b(0)) = address
ReDim Preserve b(0 To 100000)
? b(0)
? UBound(b)

' A fixed-length string member is inline in its type, padded with spaces
Dim t As TFixed
? VarPtr(t.N) - VarPtr(t)
? LenB(t)
? ReadInteger(VarPtr(t))
t.F = "ab"
? ReadInteger(VarPtr(t))
? ReadInteger(VarPtr(t) + 2)
? ReadInteger(VarPtr(t) + 4)
? ReadInteger(VarPtr(t) + 6)
? VarPtr(t.F) = VarPtr(t)

' VarPtr and StrPtr of a fixed-length string local
Dim f As String * 3
? StrPtr(f) = ReadLongPtr(VarPtr(f))
? ReadInteger(StrPtr(f))
f = "ab"
? StrPtr(f) = ReadLongPtr(VarPtr(f))
? ReadInteger(StrPtr(f))
? ReadInteger(StrPtr(f) + 2)
? ReadInteger(StrPtr(f) + 4)
? ReadLong(StrPtr(f) - 4)
? LenB(f)

' A type with a String member passed to a Declare hands the callee a copy of the string
Dim w As TWithString
Dim pointer As LongPtr
Dim original As LongPtr
w.Text = "hi"
w.N = 3
original = StrPtr(w.Text)
MoveMemory pointer, w, 8
? pointer = original
? pointer = StrPtr(w.Text)
? w.Text
? w.N

' A String member of a type is the pointer in the type's block
Dim w As TWithString
w.Text = "abc"
? ReadLongPtr(VarPtr(w)) = StrPtr(w.Text)
? VarPtr(w.N) - VarPtr(w)
? LenB(w)

' A fixed-size array member lies inline in its record
Dim g As TGuid
? LenB(g)
? VarPtr(g.D4(0)) - VarPtr(g)
? VarPtr(g.D4(7)) - VarPtr(g.D4(0))

' A fixed-size array member is aligned as its elements are
Dim t As TAligned
? VarPtr(t.L(1)) - VarPtr(t)
? VarPtr(t.L(2)) - VarPtr(t.L(1))
? LenB(t)

' A String array member holds its strings' pointers inline
Dim s As TStrings, p As LongPtr
s.S(1) = "x"
? VarPtr(s.S(0)) - VarPtr(s)
MoveMemory p, ByVal VarPtr(s.S(1)), 8
? p = StrPtr(s.S(1))

' A copy of a record copies the strings of its array member
Dim a As TStrings, b As TStrings
a.S(1) = "x"
b = a
a.S(1) = "y"
? b.S(1) & a.S(1)
? StrPtr(a.S(1)) <> StrPtr(b.S(1))

' Bytes written into a record reach its array member
Dim g As TGuid, value As LongLong
value = &H807060504030201^
MoveMemory ByVal VarPtr(g) + 8, value, 8
? g.D4(0) & "," & g.D4(7)

' VarPtr of an expression is the address of a temporary holding its value
Dim v As Long, w As Integer
MoveMemory v, ByVal VarPtr(54& + 3), 4
? v
MoveMemory w, ByVal VarPtr(&H4D42), 2
? w

' VarPtr of an element of a Variant's array is its place in the array
Dim v As Variant
v = Array(1, 2, 3)
? VarPtr(v(1)) - VarPtr(v(0))
? VarPtr(v(2)) - VarPtr(v(0))

' VarPtr of a class variable is its address: a write through it changes the variable
Dim h As New Holder
MoveMemory ByVal h.Address, 42&, 4
? h.Value

' VarPtr of a class variable stays put, and each instance has its own
Dim h As New Holder, g As New Holder
? h.Address = h.Address
? h.Address <> g.Address
? h.Address <> 0

' A Boolean member takes two bytes at two-byte alignment
Dim t As TBool
? LenB(t)
? VarPtr(t.B) - VarPtr(t)
? VarPtr(t.C) - VarPtr(t)

' Bytes written into a Boolean member are what it holds
Dim t As TBool
t.C = 7
MoveMemory ByVal VarPtr(t.B), &HFFFF, 2
? t.B
? CInt(t.B)
MoveMemory ByVal VarPtr(t.B), 1, 2
? t.B
? CInt(t.B)
? t.C

' A dynamic array member is the pointer to its descriptor
Dim t As TDyn
? LenB(t)
? VarPtrArray(t.A) - VarPtr(t)
? VarPtr(t.M) - VarPtr(t)
? ReadLongPtr(VarPtrArray(t.A)) = 0
ReDim t.A(2)
? ReadLongPtr(VarPtrArray(t.A)) <> 0
? ReadInteger(ReadLongPtr(VarPtrArray(t.A)))

' A fixed-size array of records lies inline in its record
Dim t As TOut
? LenB(t)
? VarPtr(t.P(0)) - VarPtr(t)
? VarPtr(t.P(1)) - VarPtr(t)
? VarPtr(t.P(1).Y) - VarPtr(t)
? VarPtr(t.Z) - VarPtr(t)

' A fixed-size array of fixed-length strings lies inline in its record
Dim t As TFS, i As Long, found As String
t.S(0) = "abc": t.S(1) = "xyz"
For i = 0 To LenB(t) - 1
    If ReadByte(VarPtr(t) + i) = Asc("x") Then found = found & i & " "
Next
? found
? LenB(t)
? VarPtr(t.Z) - VarPtr(t)

' A fixed-length string member after a Byte
Dim t As TFS1, i As Long, found As String
t.S = "xyz"
For i = 0 To LenB(t) - 1
    If ReadByte(VarPtr(t) + i) = Asc("x") Then found = found & i & " "
Next
? found
? LenB(t)
? VarPtr(t.Z) - VarPtr(t)

' Erase on a fixed-size array of fixed-length strings in a record
Dim t As TFS
t.S(0) = "abc": t.S(1) = "xyz"
? LBound(t.S) & UBound(t.S)
Erase t.S
? Len(t.S(0))
? AscW(t.S(0))
? AscW(Right(t.S(1), 1))

' Len and LenB of a member that is itself a type measure that type
Dim n As TNest
? LenB(n.Inner)
? Len(n.Inner)
? LenB(n)
? Len(n)
