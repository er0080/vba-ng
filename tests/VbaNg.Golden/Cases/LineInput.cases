' LineInput: which bytes end a line for Line Input # (MS-VBAL 5.4.5.4). The FileSystem cases write their
' files with Print #, which ends lines with CRLF; a file from elsewhere may end them with LF alone, as
' VBA-Web's example credentials file does. Every case works under the temp folder.

Public Function TempPath(name As String) As String
    TempPath = Environ("TEMP") & "\vbang-golden"
    If Dir(TempPath, vbDirectory) = "" Then MkDir TempPath
    TempPath = TempPath & "\" & name
End Function

Public Sub WriteText(path As String, text As String)
    Dim f As Integer
    On Error Resume Next
    Kill path
    On Error GoTo 0
    f = FreeFile
    Open path For Output As #f
    Print #f, text;
    Close #f
End Sub

' A lone LF does not end a line
Reset
Dim f As Integer, p As String, s As String
p = TempPath("lf.txt")
WriteText p, "one" & vbLf & "two" & vbLf
f = FreeFile
Open p For Input As #f
Line Input #f, s
? Len(s)
? InStr(s, vbLf)
? EOF(f)
Close #f

' A lone CR ends a line, and CRLF ends one line, not two
Reset
Dim f As Integer, p As String, s As String
p = TempPath("cr.txt")
WriteText p, "one" & vbCr & "two" & vbCrLf & "three"
f = FreeFile
Open p For Input As #f
Line Input #f, s
? s
Line Input #f, s
? s
Line Input #f, s
? s
? EOF(f)
Close #f

' An LF before a CR stays in the line the CR ends
Reset
Dim f As Integer, p As String, s As String
p = TempPath("lfcr.txt")
WriteText p, "one" & vbLf & vbCr & "two"
f = FreeFile
Open p For Input As #f
Line Input #f, s
? Len(s)
Line Input #f, s
? s
Close #f
