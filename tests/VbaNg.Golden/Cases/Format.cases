' Format: the Format function, its named formats, and the Format* helpers of the Strings module.
' Recorded under en-US; the golden header names the culture.

' Format with a fixed pattern
? Format(1.5, "0.00")

' Format rounds a binary fraction
? Format(1.005, "0.00")

' Format rounds half away from zero
? Format(2.5, "0")

' Format rounds a negative half away from zero
? Format(-2.5, "0")

' Format rounds 0.125 to two places
? Format(0.125, "0.00")

' Format rounds 0.375 to two places
? Format(0.375, "0.00")

' Format with thousands separators
? Format(1234567.891, "#,##0.00")

' Format with a percent
? Format(0.256, "0.0%")

' Format with an exponent
? Format(12345.678, "0.00E+00")

' Format with a lower-case exponent and a minus sign
? Format(0.000123, "0.00e-00")

' Format with a positive exponent and a minus sign pattern
? Format(12345.678, "0.00e-00")

' Format with two sections
? Format(-5, "0;(0)")

' Format with two sections and a positive value
? Format(5, "0;(0)")

' Format with three sections
? Format(0, "0;(0);zero")

' Format with four sections and Null
? Format(Null, "0;(0);zero;null")

' Format with four sections and an empty String
? Format("", "0;(0);zero;null")

' Format with four sections and Empty
Dim v As Variant
? Format(v, "0;(0);zero;null")

' Format with an escaped literal
? Format(5, "\$0")

' Format with a quoted literal
? Format(5, """Total: ""0")

' Format Standard
? Format(1234.5, "Standard")

' Format Fixed
? Format(1234.5, "Fixed")

' Format Percent
? Format(0.5, "Percent")

' Format Scientific
? Format(1234.5, "Scientific")

' Format General Number
? Format(1234.5, "General Number")

' Format General Number with many digits
Dim d As Double
d = 1 / 3
? Format(d, "General Number")

' Format Yes/No
? Format(0, "Yes/No")

' Format True/False
? Format(1, "True/False")

' Format On/Off
? Format(5, "On/Off")

' Format Currency
? Format(1234.5, "Currency")

' Format Currency of a negative
? Format(-1234.5, "Currency")

' Format of True without a pattern
? Format(True)

' Format of a Double without a pattern
? Format(1.5)

' Format of a Double with many digits without a pattern
Dim d As Double
d = 1 / 3
? Format(d)

' Format of a large Double without a pattern
Dim d As Double
d = 1E+20
? Format(d)

' Format of a Currency without a pattern
? Format(CCur("1.2345"))

' Format of Null
? Format(Null)

' Format of Empty
Dim v As Variant
? Format(v)

' Format of a String with a numeric pattern
? Format("1.5", "0.00")

' Format of a non-numeric String with a numeric pattern
? Format("abc", "0.00")

' Format of a String with an at pattern
? Format("abc", "@@@@@")

' Format of a String with a left-aligned at pattern
? Format("abc", "!@@@@@")

' Format of a String with an upper-case pattern
? Format("abc", ">")

' Format of a String with a lower-case pattern
? Format("ABC", "<")

' Format of a String with an ampersand pattern
? Format("abc", "&&")

' Format of a String with a mixed pattern
? Format("abc", "@-@")

' Format of a number with a String pattern
? Format(123, "@@@@")

' Format of a Date with an ISO pattern
? Format(#1/2/2020 3:04:05 PM#, "yyyy-mm-dd hh:nn:ss")

' Format of a Date with names
? Format(#1/2/2020#, "dddd, mmmm d, yyyy")

' Format of a Date with short names
? Format(#1/2/2020#, "ddd mmm")

' Format of a Date with twelve-hour time
? Format(#1/2/2020 3:04:05 PM#, "h:nn AM/PM")

' Format of a Date with lower-case am/pm
? Format(#1/2/2020 3:04:05 AM#, "hh:nn am/pm")

' Format of a Date with A/P
? Format(#1/2/2020 3:04:05 PM#, "h:nn A/P")

' Format of a Date with AMPM
? Format(#1/2/2020 3:04:05 PM#, "h:nn AMPM")

' Format of a Date with a quarter
? Format(#5/2/2020#, "q")

' Format of a Date with the day of year
? Format(#2/1/2020#, "y")

' Format of a Date with a week number
? Format(#1/2/2020#, "ww")

' Format of a Date with the weekday number
? Format(#1/2/2020#, "w")

' Format of a Date with a two-digit year
? Format(#1/2/2020#, "yy")

' Format of a Date with a four-digit year before 1000
? Format(DateSerial(999, 1, 2), "yyyy")

' Format of a Date with Short Date
? Format(#1/2/2020#, "Short Date")

' Format of a Date with Long Date
? Format(#1/2/2020#, "Long Date")

' Format of a Date with Medium Date
? Format(#1/2/2020#, "Medium Date")

' Format of a Date with Short Time
? Format(#1/2/2020 3:04:05 PM#, "Short Time")

' Format of a Date with Long Time
? Format(#1/2/2020 3:04:05 PM#, "Long Time")

' Format of a Date with Medium Time
? Format(#1/2/2020 3:04:05 PM#, "Medium Time")

' Format of a Date with General Date
? Format(#1/2/2020 3:04:05 PM#, "General Date")

' Format of a whole Date with General Date
? Format(#1/2/2020#, "General Date")

' Format of a Date without a pattern
? Format(#1/2/2020 3:04:05 PM#)

' Format of a time without a pattern
? Format(#3:04:05 PM#)

' Format of a Date whose time lies just below its second, without a pattern
? Format(#9/11/2026 2:30:00 PM#)

' Format of a Date whose time lies just below its second, with seconds
? Format(#9/11/2026 2:30:00 PM#, "h:nn:ss")

' Format of a whole Date without a pattern
? Format(#1/2/2020#)

' Format of a number with a Date pattern
? Format(43831.5, "yyyy-mm-dd hh:nn")

' Format of a String with a Date pattern
? Format("2020-01-02", "dd/mm/yyyy")

' Format with elapsed hours
? Format(#1/2/2020 3:04:05 PM#, "[h]:nn")

' Format with a three-place pattern
? Format(1.5, "0.000")

' Format a negative with a leading minus
? Format(-1.5, "0.0")

' Format with a plus in the pattern
? Format(1.5, "+0.0")

' Format with zero padding
? Format(5, "000")

' Format with hash suppresses leading zeros
? Format(0.5, "#.##")

' Format with hash of zero
? Format(0, "#")

' Format with a decimal only
? Format(0.5, ".00")

' Format with a scaling comma
? Format(1234567, "0,")

' Format with two scaling commas
? Format(1234567, "0,,")

' Format with a leading comma
? Format(1234567, ",0")

' Format of a LongLong
Dim l As LongLong
l = 9007199254740993^
? Format(l, "0")

' Format of a Currency keeps four places
? Format(CCur("1.2345"), "0.0000")

' Format of a Decimal
? Format(CDec("1234567890.123456789"), "0.000000000")

' Format of a Date with dddddd
? Format(#1/2/2020#, "dddddd")

' Format of a Date with ttttt
? Format(#1/2/2020 3:04:05 PM#, "ttttt")

' Format of a Date with c
? Format(#1/2/2020 3:04:05 PM#, "c")

' Format of a Date with escaped letters
? Format(#1/2/2020#, "\d\a\y d")

' Format of a Date with a quoted literal
? Format(#1/2/2020#, """Day ""d")

' Format of a Date with a slash
? Format(#1/2/2020#, "m/d/yyyy")

' Format of a whole day with a time pattern
? Format(#1/2/2020#, "h:nn:ss")

' Format with the n minute code
? Format(#1/2/2020 3:04:05 PM#, "n")

' Format with m after h means minutes
? Format(#1/2/2020 3:04:05 PM#, "h:m:s")

' Format with mm after h means minutes
? Format(#1/2/2020 3:04:05 PM#, "hh:mm")

' Format with m alone means month
? Format(#1/2/2020 3:04:05 PM#, "m")

' Format with mm before d means month
? Format(#1/2/2020 3:04:05 PM#, "mm-dd")

' Format of a Date before 1900
? Format(#1/2/1899#, "yyyy-mm-dd")

' Format of a negative serial
? Format(-1.5, "yyyy-mm-dd hh:nn")

' Format of a time-only value with a date pattern
? Format(#3:04:05 PM#, "yyyy-mm-dd")

' Format of a Date with a percent literal
? Format(#1/2/2020#, "d%")

' Format with a numeric pattern and a Date value
? Format(#1/2/2020#, "0.00")

' Format with a pattern that has only literals
? Format(5, "abc")

' Format with a pattern containing a colon and a number
? Format(5, "0:0")

' Format of a Boolean with a numeric pattern
? Format(True, "0")

' Format of a large number with a percent
? Format(12.5, "0%")

' Format of a number with hash placeholders only
? Format(1234.5678, "#.###")

' Format of zero with a decimal pattern
? Format(0, "0.00")

' Format of a tiny number
? Format(0.0000001, "0.00")

' Format of a tiny number with General Number
? Format(0.0000001, "General Number")

' Format with digit placeholders around the decimal
? Format(0.05, "#0.#")

' Format with a negative and sections that omit the sign
? Format(-5, "0;0")

' Format with a positive section only and a negative value
? Format(-5, "0.0")

' Format with a Null and a single section
? Format(Null, "0")

' MonthName of January
? MonthName(1)

' MonthName abbreviated
? MonthName(1, True)

' MonthName out of range
? MonthName(13)

' MonthName of zero
? MonthName(0)

' WeekdayName of Sunday
? WeekdayName(1)

' WeekdayName abbreviated
? WeekdayName(1, True)

' WeekdayName with a first day of week
? WeekdayName(1, False, vbMonday)

' WeekdayName with the system first day
? WeekdayName(1, False, vbUseSystemDayOfWeek)

' WeekdayName out of range
? WeekdayName(8)

' FormatNumber with defaults
? FormatNumber(1234.5678)

' FormatNumber with two decimals
? FormatNumber(1234.5678, 2)

' FormatNumber without a leading digit
? FormatNumber(0.5, 2, vbFalse)

' FormatNumber with parentheses for negatives
? FormatNumber(-5, 2, vbTrue, vbTrue)

' FormatNumber without grouping
? FormatNumber(1234.5, 2, vbTrue, vbFalse, vbFalse)

' FormatNumber with minus one decimals uses the default
? FormatNumber(1234.5678, -1)

' FormatNumber of Null
? FormatNumber(Null)

' FormatNumber of a String
? FormatNumber("1234.5")

' FormatNumber rounds half away from zero
? FormatNumber(2.5, 0)

' FormatPercent with defaults
? FormatPercent(0.256)

' FormatPercent with one decimal
? FormatPercent(0.256, 1)

' FormatCurrency with defaults
? FormatCurrency(1234.5)

' FormatCurrency of a negative
? FormatCurrency(-1234.5)

' FormatCurrency with parentheses
? FormatCurrency(-1234.5, 2, vbTrue, vbTrue)

' FormatDateTime General Date
? FormatDateTime(#1/2/2020 3:04:05 PM#)

' FormatDateTime Long Date
? FormatDateTime(#1/2/2020 3:04:05 PM#, vbLongDate)

' FormatDateTime Short Date
? FormatDateTime(#1/2/2020 3:04:05 PM#, vbShortDate)

' FormatDateTime Long Time
? FormatDateTime(#1/2/2020 3:04:05 PM#, vbLongTime)

' FormatDateTime Short Time
? FormatDateTime(#1/2/2020 3:04:05 PM#, vbShortTime)

' A date pattern keeps its zeros as text when the value is a Date or a number
? Format(#1/2/2003 3:04:06 AM#, "yyyy-mm-ddTHH:mm:ss.000Z")
? Format(#1/2/2003 3:04:06 AM#, "hh:mm:ss.00")
? Format(37623.5, "yyyy-mm-ddTHH:mm:ss.000Z")
? Format(1.5, "0.00 yyyy")

' FormatDateTime of a String
? FormatDateTime("2020-01-02", vbShortDate)

' FormatDateTime with an invalid format
? FormatDateTime(#1/2/2020#, 9)
