Dim l As Long
l = 16777217
? CSng(l)

' CSng of a tiny Double underflows to zero
Dim d As Double
d = 1E-50
? CSng(d)

' CCur of a Double
? CCur(1.5)

' CCur rounds to four places
? CCur(1.00005)

' CCur rounds a fifth-place five
? CCur(1.00015)

' CCur rounds a fifth-place four down
? CCur(1.00004)

' CCur of a negative that rounds
? CCur(-1.00005)

' CCur of a String
? CCur("1.5")

' CCur of a String with a currency symbol
? CCur("$1.50")

' CCur overflow
Dim d As Double
d = 1E+15
? CCur(d)

' CCur of True
? CCur(True)

' CCur of Null
? CCur(Null)

' CCur of Empty
Dim v As Variant
? CCur(v)

' CCur of a Decimal with more than four places
