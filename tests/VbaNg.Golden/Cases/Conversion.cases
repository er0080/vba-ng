? CDec(True)

' CDec of Null
? CDec(Null)

' CDec of an Integer
Dim i As Integer
i = 5
? CDec(i)

' CDec of a Double with an exponent
? CDec(1E+20)

' CDec of a String with an exponent
? CDec("1E-5")

' CDec of zero
? CDec(0)

' CDec of a negative zero String
? CDec("-0.0")

' CDec of Strings with trailing zeros and the scale each keeps
? CDec("1.0")
? CDec("1.000")
? CDec("0.00")
? CDec("10.0")
? CDec("100")
? CDec("1.50")
? CDec("0")
? CDec("-0")
? CDec(".0")
? CDec("0.10")
? CDec("1E2")
? CDec("1.5E1")
? CDec("1.50E1")

' CStr of True
? CStr(True)

' CStr of False
? CStr(False)

' CStr of a Double
? CStr(1.5)

' CStr of a Double with fifteen digits
Dim d As Double
d = 1 / 3
? CStr(d)

' CStr of a Double that needs an exponent
Dim d As Double
d = 1E+20
? CStr(d)

' CStr of a small Double
Dim d As Double
d = 0.0001
? CStr(d)

' CStr of a smaller Double
Dim d As Double
d = 0.00001
? CStr(d)

' CStr of a Double at the exponent threshold
Dim d As Double
d = 123456789012345#
? CStr(d)

' CStr of a Double just past the exponent threshold
Dim d As Double
d = 1234567890123456#
? CStr(d)

' CStr of a Double with sixteen significant digits
Dim d As Double
d = 0.1234567890123456
? CStr(d)

' CStr of a negative fraction
Dim d As Double
d = -0.5
? CStr(d)

' CStr of a positive fraction keeps the leading zero
Dim d As Double
d = 0.5
? CStr(d)

' CStr of negative zero
Dim d As Double
d = -1
d = d * 0
? CStr(d)

' CStr of a Single
Dim s As Single
s = 0.1
? CStr(s)

' CStr of a Single with seven digits
Dim s As Single
s = 1 / 3
? CStr(s)

' CStr of a large Single
Dim s As Single
s = 1E+20
? CStr(s)

' CStr of a Currency
? CStr(CCur(1.5))

' CStr of a Currency with four places
? CStr(CCur("1.2345"))

