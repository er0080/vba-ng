' CDec of a String
? CDec("0.1")

' CDec of a String with many digits
? CDec("1234567890123456789012345678")

' CDec of a Double
? CDec(0.1)

' CDec of a String with trailing zeros keeps the scale
? CDec("1.500")

' CDec of a negative
? CDec("-1.5")

' CDec of a Currency
? CDec(CCur(1.5))

' CDec overflow
? CDec("1E29")

