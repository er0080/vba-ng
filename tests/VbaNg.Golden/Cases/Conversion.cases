? CStr(CCur(2))

' CStr of a Decimal
? CStr(CDec("1.500"))

' CStr of a Date
? CStr(#1/2/2020#)

' CStr of a Date with time
? CStr(#1/2/2020 3:04:05 PM#)

' CStr of a time only
? CStr(#3:04:05 PM#)

' CStr of a Date whose time lies just below its second
? CStr(#9/11/2026 2:30:00 PM#)

' CStr of a Date at midnight
? CStr(#1/2/2020 12:00:00 AM#)

' CStr of Empty
Dim v As Variant
? CStr(v)

' CStr of Null
? CStr(Null)

