s = 0.1
? CDbl(s)

' CDbl of a Date
? CDbl(#1/1/2020 6:00:00 AM#)

' CDbl of True
? CDbl(True)

' CDbl of Empty
Dim v As Variant
? CDbl(v)

' CDbl of Null
? CDbl(Null)

' CDbl of a Decimal
? CDbl(CDec("0.1"))

' CDbl overflow from a String
? CDbl("1E400")

' CDbl of a hex String
? CDbl("&HFF")

' CSng of a Double
? CSng(0.1)

' CSng of a String
? CSng("3.14159265358979")

' CSng overflow
Dim d As Double
d = 1E+39
? CSng(d)

