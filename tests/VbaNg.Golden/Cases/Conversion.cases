' Conversion: the Conversion module of the VBA standard library and let-coercion into typed variables (MS-VBAL 5.6.9.3).
' Out-of-range and non-numeric values go through variables so the VBA compiler cannot fold them.

' CInt rounds half to even
? CInt(2.5)

' CInt rounds half to even upward
? CInt(3.5)

' CInt rounds a negative half to even
? CInt(-2.5)

' CInt of a value just above half
? CInt(2.5000001)

' CInt overflow
Dim v As Variant
v = 32768
? CInt(v)

' CInt of a value that rounds to the maximum
Dim v As Variant
v = 32767.4
? CInt(v)

' CInt of a value that rounds past the maximum
Dim v As Variant
v = 32767.5
? CInt(v)

' CInt of a numeric String
? CInt("12")

' CInt of a String with spaces
? CInt(" 12 ")

' CInt of a String with an exponent
? CInt("1e3")

' CInt of a hex String
? CInt("&H10")

' CInt of an octal String
? CInt("&O10")

' CInt of a String with a thousands separator
? CInt("1,000")

' CInt of an empty String
? CInt("")

' CInt of a non-numeric String
? CInt("abc")

' CInt of a String with a trailing letter
? CInt("12abc")

' CInt of a decimal String rounds
? CInt("2.5")

' CInt of a String with a leading plus
? CInt("+5")

' CInt of a String with a trailing minus
? CInt("5-")

' CInt of a String with a currency symbol
? CInt("$5")

' CInt of a String with a percent sign
? CInt("50%")

' CInt of a String with parentheses
? CInt("(5)")

' CInt of True
? CInt(True)

' CInt of Empty
Dim v As Variant
? CInt(v)

' CInt of Null
? CInt(Null)

' CInt of a Date
? CInt(#1/1/2020#)

' CInt of a Currency
? CInt(CCur(2.5))

' CInt of a Decimal
? CInt(CDec(2.5))

' CInt of a Single
Dim s As Single
s = 2.5
? CInt(s)

' CInt of a String that is only a decimal point
? CInt(".")

' CInt of a String with a trailing tab
? CInt("7" & vbTab)

' CInt of a String with a leading newline
? CInt(vbLf & "7")

' CInt of an Error value
? CInt(CVErr(5))

' CLng rounds half to even
? CLng(2.5)

' CLng rounds a negative half to even
? CLng(-3.5)

' CLng overflow
Dim d As Double
d = 2147483648#
? CLng(d)

' CLng of the Long minimum
Dim d As Double
d = -2147483648#
? CLng(d)

' CLng of a hex String with sixteen bits set
? CLng("&HFFFF")

' CLng of a hex String with a Long suffix
? CLng("&HFFFF&")

' CLng of a String with an exponent and a decimal
? CLng("1.5e3")

' CLng of a Boolean
? CLng(True)

' CLng of a Date at noon
? CLng(#1/1/2020 12:00:00 PM#)

' CLng of a Date just before noon
? CLng(#1/1/2020 11:59:59 AM#)

' CLng of a Date at noon on an odd serial
? CLng(#1/2/2020 12:00:00 PM#)

' CLngLng of a large Double
Dim d As Double
d = 1E+15
? CLngLng(d)

' CLngLng rounds half to even
? CLngLng(2.5)

' CLngLng overflow
Dim d As Double
d = 1E+19
? CLngLng(d)

' CLngPtr of a value
? CLngPtr(5)

' CByte of 255
? CByte(255)

' CByte overflow
Dim v As Variant
v = 256
? CByte(v)

' CByte of a negative
Dim v As Variant
v = -1
? CByte(v)

' CByte of a small negative that rounds to zero
Dim v As Variant
v = -0.4
? CByte(v)

' CByte rounds half to even
? CByte(2.5)

' CByte of a String
? CByte("200")

' CByte of True
? CByte(True)

' CBool of the String True
? CBool("True")

' CBool of the String false in lower case
? CBool("false")

' CBool of a numeric String
? CBool("1")

' CBool of a zero String
? CBool("0")

' CBool of a non-numeric String
? CBool("abc")

' CBool of zero
? CBool(0)

' CBool of a fraction
? CBool(0.1)

' CBool of Empty
Dim v As Variant
? CBool(v)

' CBool of Null
? CBool(Null)

' CBool of an empty String
? CBool("")

' CBool of a String with spaces
? CBool(" True ")

' CBool of a hash-delimited String
? CBool("#TRUE#")

' CBool of a negative String
? CBool("-1")

' CBool of a Date
? CBool(#1/1/2020#)

' CDbl of a String
? CDbl("1.5")

' CDbl of a String with an exponent
? CDbl("1.5E+300")

