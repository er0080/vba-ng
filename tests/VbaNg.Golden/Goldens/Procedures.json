    "    r(0) = UBound(v)",
    "    Halved = r",
    "End Function",
    "",
    "Public Function TwiceOver(ParamArray items() As Variant) As String",
    "    Dim item As Variant",
    "    For Each item In items",
    "        TwiceOver = TwiceOver & item",
    "    Next",
    "    For Each item In items",
    "        TwiceOver = TwiceOver & item",
    "    Next",
    "End Function",
    "",
    "Public Function Widths(ParamArray items() As Variant) As String",
    "    Dim item As Variant",
    "    For Each item In items",
    "        Widths = Widths & UBound(item)",
    "    Next",
    "    For Each item In items",
    "        Widths = Widths & UBound(item)",
    "    Next",
    "End Function",
    "",
    "Public Function Describe(Optional ByVal label As String = \"none\", Optional ByVal count As Long = 3) As String",
    "    Describe = label & \":\" & count",
    "End Function",
    "",
    "Public Function MissingCount(Optional ByVal a As Variant, Optional ByVal b As Variant) As Long",
    "    MissingCount = 0",
    "    If IsMissing(a) Then MissingCount = MissingCount + 1",
    "    If IsMissing(b) Then MissingCount = MissingCount + 1",
    "End Function",
    "",
    "Public Function Total(ParamArray items() As Variant) As Long",
    "    Dim i As Long",
    "    Total = 0",
    "    For i = LBound(items) To UBound(items)",
    "        Total = Total + items(i)",
    "    Next i",
    "End Function",
    "",
    "Public Function ParamBounds(ParamArray items() As Variant) As String",
    "    ParamBounds = LBound(items) & \",\" & UBound(items)",
    "End Function",
    "",
    "Public Function ParamArrayTypeName(ParamArray items() As Variant) As String",
    "    ParamArrayTypeName = TypeName(items)",
    "End Function",
    "",
    "Public Function Counter() As Long",
    "    Static calls As Long",
