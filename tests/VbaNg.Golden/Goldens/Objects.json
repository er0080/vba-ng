      "name": "FileSystemObject: nested objects and a text file round trip",
      "source": [
        "Dim fso As Object, ts As Object, path As String",
        "Set fso = CreateObject(\"Scripting.FileSystemObject\")",
        "? TypeName(fso)",
        "path = fso.BuildPath(fso.GetSpecialFolder(2).Path, fso.GetTempName)",
        "Set ts = fso.CreateTextFile(path, True)",
        "? TypeName(ts)",
        "ts.WriteLine \"hello\"",
        "ts.Write \"world\"",
        "ts.Close",
        "? fso.FileExists(path)",
        "Set ts = fso.OpenTextFile(path, 1)",
        "? ts.ReadAll",
        "ts.Close",
        "? fso.GetFile(path).Size",
        "fso.DeleteFile path",
        "? fso.FileExists(path)"
      ],
