      "name": "Keys returns a Variant array and For Each walks the keys",
      "source": [
        "Dim d As Object",
        "Dim k As Variant",
        "Dim s As String",
        "Set d = CreateObject(\"Scripting.Dictionary\")",
        "d.Add \"x\", 1",
        "d.Add \"y\", 2",
        "? TypeName(d.Keys)",
        "? UBound(d.Keys)",
        "For Each k In d",
        "    s = s & k & \";\"",
        "Next k",
        "? s",
