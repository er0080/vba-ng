<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ExcelDnaCreate32BitAddIn>false</ExcelDnaCreate32BitAddIn>
    <ExcelDnaCreate64BitAddIn>true</ExcelDnaCreate64BitAddIn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>The vba-ng Excel add-in: loads built projects and runs them inside Excel.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VbaNg.Interop\VbaNg.Interop.csproj" />
    <ProjectReference Include="..\VbaNg.Runtime\VbaNg.Runtime.csproj" />
  </ItemGroup>

</Project>
